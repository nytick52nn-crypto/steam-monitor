# Copy to .env and fill in real values

TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789
TELEGRAM_ENABLED=true
TELEGRAM_STARTUP_TEST=true
TELEGRAM_VALIDATE_SIGNALS=false

# Telegram settings
TELEGRAM_REQUEST_TIMEOUT=15

# Retry settings
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_DELAY=3

# Use proxy if Telegram is blocked in your region:
# Example:
# TELEGRAM_PROXY_URL=socks5://user:pass@host:port
# TELEGRAM_PROXY_URL=http://host:port
TELEGRAM_PROXY_URL=

STEAM_MARKET_FEE_PCT=15
MIN_HISTORY_FOR_SIGNAL=20
ALERT_COOLDOWN_SEC=3600

STEAM_APP_ID=730
STEAM_CURRENCY=5
CHECK_INTERVAL_SEC=60

# Steam API request delays (seconds between requests)
# Keep 10-20s to avoid Steam 429 rate limit bans
STEAM_REQUEST_DELAY_MIN=10
STEAM_REQUEST_DELAY_MAX=20

# Steam session cookies — REQUIRED for Docker to bypass IP blocks
# How to get:
# 1. Login to steamcommunity.com in browser
# 2. Press F12 -> Application tab -> Cookies -> steamcommunity.com
# 3. Copy 'sessionid' value to STEAM_SESSION_COOKIE
# 4. Copy 'steamLoginSecure' value to STEAM_LOGIN_SECURE
# Refresh every ~30 days when blocks start occurring
STEAM_SESSION_COOKIE=
STEAM_LOGIN_SECURE=

# Items file (list of tracked market items)
ITEMS_FILE=data/items.json

# Virtual wallet (paper balance in ₽)
WALLET_INITIAL_BALANCE=10000

# Paper trading (BUY only; no SELL yet)
PAPER_TRADING_ENABLED=true
MAX_POSITION_PCT=10
